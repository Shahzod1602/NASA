APOLLO_TEXT("ReadyMessage", "Apollo 12, 1969-yil noyabr. Oy namunalarini va Surveyor qismlarini olib qayting.", "Apollo 12, November 1969. Return lunar samples and Surveyor hardware for study.")
APOLLO_TEXT("StartMessage", "Intrepid yonidan boshlang. Sichqoncha bilan qarang, WASD bilan yuring. Oltin belgi birinchi ishni ko‘rsatadi.", "Begin beside Intrepid. Look with the mouse, walk with WASD. The gold marker shows your first task.")
APOLLO_TEXT("AntennaWrong", "Antenna hali sozlanmagan. Q bilan burab 353° ga yaqinlashtiring, so‘ng E bilan tekshiring.", "The antenna is off bearing. Turn it toward 353° with Q, then hold E to verify.")
APOLLO_TEXT("PhotoMessage", "Joy fotosi qayd etildi. Endi E ni ushlab namunani yorliqlang va qadoqlang.", "Context photo recorded. Now hold E to label and seal the sample.")
APOLLO_TEXT("SurveyorPhotoMessage", "Surveyor holati qayd etildi. Kamera, tuproq kuragi va kabelni oling.", "Surveyor documented. Retrieve the camera, soil scoop and cable.")
APOLLO_TEXT("CheckoutDone", "Tayyorgarlik tugadi. Seysmometr tomon yuring. Tab xaritani ochadi va o‘yinni pauzaga qo‘yadi.", "Checkout complete. Walk to the seismometer. Tab opens the map and pauses play.")
APOLLO_TEXT("SuitDone", "Skafandr tekshirildi. Endi shu joyda kamera va namuna asboblarini tayyorlang.", "Suit support checked. Now prepare the camera and sample tools at the kit.")
APOLLO_TEXT("ToolsDone", "Asboblar tayyor. Intrepidga qaytish yo‘lini tasdiqlang.", "Tools ready. Confirm the return route to Intrepid.")
APOLLO_TEXT("InstrumentsDone", "ALSEP tayyor. Head, Bench va Sharp joylaridagi uch namunani foto bilan qayd etib yig‘ing.", "ALSEP ready. Photograph and collect the three samples at Head, Bench and Sharp.")
APOLLO_TEXT("SeismometerDone", "Seysmometr joylashtirildi. Endi markaziy stansiya antennasini Yer tomonga sozlang.", "Seismometer deployed. Now aim the central-station antenna toward Earth.")
APOLLO_TEXT("SamplesDone", "Uch namuna qadoqlandi. Endi Surveyor 3 tomon qulay yo‘lni tanlang; Tab xaritada tarixiy yo‘lni ko‘rsatadi.", "Three samples sealed. Choose your route to Surveyor 3; Tab shows the historical traverse.")
APOLLO_TEXT("SampleDone", "Namuna va uning joyi qayd etildi. Keyingi namunaga boring; Q manzilni almashtiradi.", "Sample and context recorded. Continue to another site; Q changes the destination.")
APOLLO_TEXT("SurveyorReached", "Surveyor 3 ga yetdingiz. Avval qurilmaning umumiy fotosini oling, so‘ng qismlarini yig‘ing.", "Surveyor 3 reached. Photograph the spacecraft before retrieving its parts.")
APOLLO_TEXT("PartsDone", "Kamera, kurak va kabel qadoqlandi. Namunalar bilan Intrepidga qayting.", "Camera, scoop and cable packed. Return to Intrepid with the samples.")
APOLLO_TEXT("PartDone", "Detal qadoqlandi. Qolgan kamera, kurak yoki kabel qismlarini oling.", "Hardware packed. Retrieve the remaining camera, scoop or cable parts.")
APOLLO_TEXT("MissionDone", "Vazifa tugadi. Oy namunalari va Surveyor qismlari Intrepid yonida topshirildi.", "Expedition complete. Lunar samples and Surveyor hardware are stowed at Intrepid.")
APOLLO_TEXT("TimeWarning", "Mashq tugashiga uch daqiqa qoldi. Tab orqali qaytish yo‘lini tekshiring.", "Three exercise minutes remain. Check the return route with Tab.")
APOLLO_TEXT("TimeEnded", "Mashq vaqti tugadi. Ekipaj xavfsiz qaytadi; yo‘lni qayta sinab ko‘ring.", "The exercise window ended. The crew returns safely; try the route again.")
APOLLO_TEXT("LeftArea", "Xaritadagi hududdan chiqib ketdingiz. Qayta boshlang va xaritadagi manzillardan foydalaning.", "You left the mapped exercise area. Restart and use the field map.")
