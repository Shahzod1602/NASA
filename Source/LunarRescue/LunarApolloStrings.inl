APOLLO_TEXT("PurposeCheckout", "Yo‘lga chiqishdan oldin skafandr, asboblar va qaytish yo‘lini tekshiring.", "Check your suit, tools and return route before leaving Intrepid.")
APOLLO_TEXT("PurposeDeploy", "Seysmometr Oy tebranishlarini qayd etadi. Antenna ma’lumotni Yerga uzatadi.", "The seismometer records lunar vibrations. The antenna sends data to Earth.")
APOLLO_TEXT("PurposeSamples", "Foto namunaning olingan joyini, yorliq esa uning kimligini saqlaydi.", "A photo preserves the collection context; a label identifies the sample.")
APOLLO_TEXT("PurposeTraverse", "Surveyor qismlari Oy muhitining uskunalarga ta’sirini o‘rganish uchun kerak.", "Returned Surveyor parts help researchers study exposure to the lunar environment.")
APOLLO_TEXT("PurposeRecover", "Avval qurilmaning holatini qayd eting, so‘ng qismlarini Yerda tekshirish uchun oling.", "Document the spacecraft first, then retrieve parts for study on Earth.")
APOLLO_TEXT("PurposeReturn", "Dalillar Intrepid yonidagi yuk joyiga topshirilganda vazifa tugaydi.", "The expedition is complete when the evidence is stowed at Intrepid.")
APOLLO_TEXT("InstructionCheckout0", "Oltin belgi yonidagi stolga boring. Stolga qarab E ni ushlab, skafandr holatini tekshiring.", "Walk to the gold field-kit marker. Look at the table and hold E to check suit support.")
APOLLO_TEXT("InstructionCheckout1", "Skafandr tekshirildi. Shu yerdagi kamera va namuna asboblarini E ni ushlab tayyorlang.", "Suit checked. Hold E at the kit to prepare the camera and sample tools.")
APOLLO_TEXT("InstructionCheckout2", "Asboblar tayyor. E ni ushlab qaytish yo‘lini tasdiqlang. Tab xaritani ochadi.", "Tools ready. Hold E to confirm your return route. Tab opens the map.")
APOLLO_TEXT("InstructionSeismometer", "Seysmometr belgisiga boring. Asbobga qarang va E ni ushlab joylashtiring.", "Follow the seismometer marker. Look at the instrument and hold E to deploy it.")
APOLLO_TEXT("InstructionAntenna", "Antenna: {Angle}° / Yer: 353°. Q bilan 15° burang, so‘ng E ni ushlab aloqani tekshiring.", "Antenna: {Angle}° / Earth: 353°. Q turns by 15°; hold E to verify the link.")
